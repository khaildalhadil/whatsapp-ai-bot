# Copy this file to ".env" and fill in the values.
# Never commit .env: it holds your secret token.

# Meta dashboard > WhatsApp > API Setup > "Generate token"
WHATSAPP_TOKEN=

# Same page, "Phone Number ID"
PHONE_NUMBER_ID=

# Any secret word you choose. You will type the same word in Meta's webhook settings (Part 2).
VERIFY_TOKEN=
