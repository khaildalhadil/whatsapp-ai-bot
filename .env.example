# Copy this file to ".env" and fill in the values.
# Never commit .env: it holds your secret token.

# Meta dashboard > WhatsApp > API Setup > "Generate token"
WHATSAPP_TOKEN=

# Same page, "Phone Number ID"
PHONE_NUMBER_ID=

# platform.openai.com > API keys > "Create new secret key"
OPENAI_API_KEY=

# Optional: which OpenAI model answers (default: gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# Password for the /dashboard page (user: admin). Pick a long random one.
DASHBOARD_PASSWORD=

# Optional: where the bookings database is saved (default: bookings.db next to app.py)
# DATABASE_PATH=/home/data/bookings.db
